# ISIC Skin Lesion Analysis - Backend Environment Configuration

# Database: Defaults to SQLite if DATABASE_URL is not set
# For PostgreSQL: postgresql://username:password@localhost:5432/isic_db
DATABASE_URL=sqlite:///./isic_app.db

# Authentication / Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional CORS additions (comma-separated if needed)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
